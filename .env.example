# Set your internal Notion integration token and share the database with it.
NOTION_TOKEN=
# Generate with: openssl rand -hex 48
ACCESS_KEY=
# Optional external HTTPS origin, for example a Tailscale Serve URL.
ORIGIN=http://localhost:3210
# Optional property names; defaults are Event name and Date.
TITLE_PROPERTY=
DATE_PROPERTY=
# Required for the cleanup service. Use the source ID, not the database/view ID.
CLEANUP_DATA_SOURCE_ID=
CLEANUP_STATUS_PROPERTY=Status
CLEANUP_DONE_STATUS=Done
